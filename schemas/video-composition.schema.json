{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-conveyor.local/schemas/video-composition.schema.json",
  "title": "Video composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productionId", "width", "height", "fps", "durationInFrames", "scenes", "audioTracks", "captions", "visual", "provenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "productionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "width": {"type": "integer", "minimum": 320, "maximum": 3840},
    "height": {"type": "integer", "minimum": 320, "maximum": 3840},
    "fps": {"type": "integer", "minimum": 12, "maximum": 60},
    "durationInFrames": {"type": "integer", "minimum": 1, "maximum": 108000},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "from", "durationInFrames", "title", "body", "assetRefs", "animation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "kind": {"enum": ["hook", "pipeline", "infographic", "output", "end-card"]},
          "from": {"type": "integer", "minimum": 0},
          "durationInFrames": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 80},
          "body": {"type": "string", "maxLength": 180},
          "assetRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}},
          "animation": {"type": "object", "additionalProperties": false, "required": ["preset", "intensity"], "properties": {"preset": {"enum": ["impact", "reveal", "orbit", "parallax", "resolve"]}, "intensity": {"type": "number", "minimum": 0, "maximum": 1}}}
        }
      }
    },
    "audioTracks": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "from", "durationInFrames", "volume", "fadeInFrames", "fadeOutFrames", "kind"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "path": {"$ref": "#/$defs/safePath"}, "from": {"type": "integer", "minimum": 0}, "durationInFrames": {"type": "integer", "minimum": 1}, "volume": {"type": "number", "minimum": 0, "maximum": 1}, "fadeInFrames": {"type": "integer", "minimum": 0}, "fadeOutFrames": {"type": "integer", "minimum": 0}, "kind": {"enum": ["synthetic-bed", "voiceover"]}
      }}
    },
    "captions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "text", "startFrame", "endFrame", "safeBottom", "maxWidth"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "text": {"type": "string", "minLength": 1, "maxLength": 100}, "startFrame": {"type": "integer", "minimum": 0}, "endFrame": {"type": "integer", "minimum": 1}, "safeBottom": {"type": "integer", "minimum": 120, "maximum": 520}, "maxWidth": {"type": "integer", "minimum": 400, "maximum": 960}
      }}
    },
    "visual": {"type": "object", "additionalProperties": false, "required": ["background", "primary", "accent", "seed"], "properties": {"background": {"$ref": "#/$defs/color"}, "primary": {"$ref": "#/$defs/color"}, "accent": {"$ref": "#/$defs/color"}, "seed": {"type": "integer"}}},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["asset", "source", "rights"], "properties": {"asset": {"$ref": "#/$defs/safePath"}, "source": {"type": "string", "minLength": 1}, "rights": {"enum": ["repository-authored", "owner-provided"]}}}}
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "safePath": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*(?:^|[/\\\\])(?:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\.|[/\\\\]|$))[A-Za-z0-9._/\\\\-]+$"}
  }
}
