# Copy to .env locally. Never commit the real .env.

# ElevenLabs: required only for explicitly approved API calls.
ELEVENLABS_API_KEY=

# Optional project-selected voice; do not assume a remembered ID is valid.
ELEVENLABS_VOICE_ID=

# Remotion license gate. Use only after determining eligibility and following
# current Remotion terms; do not commit a private rm_sec_ key.
REMOTION_LICENSE_KEY=
